---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackagesPage from '../components/PackagesPage';
import { groups } from '../components/PricingSection';

// Product data for search engines and AI answers, generated from the same list as the pricing cards.
const site = Astro.site!;
const products = groups.flatMap(group => group.packages.map(item => ({
  '@type': 'Product',
  name: `${item.name} (${item.size})`,
  description: item.text,
  image: new URL(group.id === 'busts' ? '/wivork/products/couple-bust.webp' : '/wivork/products/signature-miniature.webp', site).href,
  brand: { '@type': 'Brand', name: 'wivork' },
  offers: {
    '@type': 'Offer',
    price: item.price.replace(/[^\d]/g, ''),
    priceCurrency: 'LKR',
    availability: 'https://schema.org/InStock',
    url: new URL('/packages', site).href,
    seller: { '@id': new URL('/#organization', site).href },
  },
})));
---
<BaseLayout
  title="Miniature & Portrait Bust Prices in Sri Lanka | wivork"
  description="Custom portrait busts from Rs. 1,800 and full-figure 18cm miniatures from Rs. 10,000. Single or couple, sculpted from your photos and hand-painted."
  image="/og/packages.jpg"
  imageAlt="A hand-painted wivork miniature of a woman in a red sari with a gold handbag"
  bodyId="top"
  schema={products}
>
  <PackagesPage client:load />
</BaseLayout>
