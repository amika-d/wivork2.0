---
// Shared <head> for every page: SEO, social share previews and structured data.
import '../styles/local.css';

interface Props {
  title: string;
  description: string;
  /** Share image under /og, 1200 × 630. */
  image: string;
  imageAlt: string;
  themeColor?: string;
  bodyId?: string;
  /** Extra schema.org objects for this page. */
  schema?: object[];
}

const { title, description, image, imageAlt, themeColor = '#111111', bodyId, schema = [] } = Astro.props;
const site = Astro.site!;
// Pages are linked without a trailing slash; Vercel redirects the slash form (vercel.json trailingSlash).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), site).href;
const imageUrl = new URL(image, site).href;
const organization = {
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: 'wivork',
  url: site.href,
  logo: new URL('/wivork/favicon.png', site).href,
  description: 'A creative studio in Sri Lanka making custom 3D-sculpted, resin-printed and hand-painted miniatures and portrait busts from your photos.',
  areaServed: 'LK',
  contactPoint: { '@type': 'ContactPoint', telephone: '+94722227440', contactType: 'customer service', availableLanguage: ['en', 'si'] },
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    { '@type': 'WebSite', '@id': new URL('/#website', site).href, name: 'wivork', url: site.href, publisher: { '@id': organization['@id'] } },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" href="/wivork/favicon.png" />
    <link rel="preload" href="/fonts/SanaSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="wivork" />
    <meta property="og:locale" content="en_LK" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body id={bodyId}><slot /></body>
</html>
